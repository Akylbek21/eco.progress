# Пример окружения для docker-compose. Скопируйте в .env и заполните реальными значениями.
# В репозиторий реальные секреты не коммитятся: .env должен быть в .gitignore.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=eco
MYSQL_PASSWORD=

# --- MongoDB ---
MONGO_USERNAME=eco
MONGO_PASSWORD=

# --- mongo-express (профиль tools) ---
MONGO_EXPRESS_PASSWORD=

# --- JWT ---
# Обязателен, минимум 32 символа. Сгенерировать:
#   openssl rand -base64 48
ECO_JWT_SECRET=

# --- SMTP ---
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
