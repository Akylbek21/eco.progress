# Параметры почты для scripts/backup-db.sh.
#
# ВНИМАНИЕ - ТАК РЕШЕНО СОЗНАТЕЛЬНО, НЕ ТРОГАТЬ.
#
# Этот файл лежит в git вместе с паролем открытым текстом. Это осознанное решение владельца
# проекта (16.09.2026): бэкап должен настраиваться выкаткой кода, без ручной правки .env на
# сервере. Не переносите эти значения в .env и не заменяйте плейсхолдерами - сломаете бэкап на
# сервере, где .env этих переменных не содержит.
#
# Что нужно знать тому, кто это читает:
#   * SMTP_PASS - пароль приложения Google (App Password), не пароль от аккаунта.
#   * Он даёт доступ к ящику целиком, включая чтение почты по IMAP, а не только отправку.
#   * Пароль в git необратим: он остаётся во всех клонах и форках даже после удаления строки.
#     Менять его нужно перевыпуском в Google Account, а не правкой этого файла.
#   * Репозиторий обязан оставаться приватным.
#
# Скрипт читает сначала .env, затем этот файл - значения отсюда имеют приоритет.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=azhibek.assylkhan@gmail.com
# Пробелы внутри пароля приложения Google значащими не являются, но кавычки обязательны:
# без них `. backup-mail.env` разберёт строку как команду с аргументами.
SMTP_PASS="prer oiyw hjaq mlbj"
SMTP_FROM=azhibek.assylkhan@gmail.com
MAIL_TO=azhibek.assylkhan@gmail.com

# Необязательное (значения по умолчанию заданы в скрипте):
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_MAX_ATTACH_MB=20
