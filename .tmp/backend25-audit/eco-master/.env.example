# Пример окружения для docker-compose. Скопируйте в .env и заполните реальными значениями.
# В репозиторий реальные секреты не коммитятся: .env должен быть в .gitignore.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=eco
MYSQL_PASSWORD=

# --- MongoDB ---
MONGO_USERNAME=eco
MONGO_PASSWORD=

# --- mongo-express (профиль tools) ---
MONGO_EXPRESS_PASSWORD=

# --- JWT ---
# Обязателен, минимум 32 символа. Сгенерировать:
#   openssl rand -base64 48
ECO_JWT_SECRET=

# --- SMTP (почта приложения) ---
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Бэкап БД на почту (scripts/backup-db.sh) ---
# Здесь ничего задавать не нужно: параметры почты для бэкапа лежат в deploy/backup-mail.env,
# который хранится в git вместе с паролем. Так решено сознательно, чтобы бэкап настраивался
# выкаткой кода без ручной правки .env на сервере - см. шапку того файла.
