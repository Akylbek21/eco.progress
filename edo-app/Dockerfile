FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_EDO_API_URL
ARG VITE_EDO_APP_URL
ARG VITE_MAIN_SITE_URL
ARG VITE_CRM_URL
ARG VITE_NCALAYER_WS_URL=wss://127.0.0.1:13579/
ARG VITE_ENVIRONMENT=production
ENV VITE_EDO_API_URL=$VITE_EDO_API_URL
ENV VITE_EDO_APP_URL=$VITE_EDO_APP_URL
ENV VITE_MAIN_SITE_URL=$VITE_MAIN_SITE_URL
ENV VITE_CRM_URL=$VITE_CRM_URL
ENV VITE_NCALAYER_WS_URL=$VITE_NCALAYER_WS_URL
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
