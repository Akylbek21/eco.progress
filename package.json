{
  "name": "eco-progress",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node --loader ./scripts/ts-loader.mjs scripts/generate-sitemap.js",
    "seo:content:sync": "node scripts/sync-seo-content.mjs",
    "seo:content:validate": "node scripts/sync-seo-content.mjs --validate-only",
    "seo:reviews:sync": "npm run seo:content:sync",
    "seo:reviews:validate": "npm run seo:content:validate",
    "images:optimize": "node scripts/optimize-images.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node --test tests/interactive-markup.test.mjs",
    "prerender": "vite build --ssr scripts/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "seo:audit": "node scripts/linguistic-content-audit.mjs && node scripts/seo-audit.mjs",
    "seo:noindex-report": "node scripts/noindex-report.mjs",
    "content:audit": "node --loader ./scripts/ts-loader.mjs scripts/content-audit.mjs",
    "content:export": "node --loader ./scripts/ts-loader.mjs scripts/content-export.mjs",
    "content:migrate:dry-run": "node --loader ./scripts/ts-loader.mjs scripts/content-export.mjs --dry-run",
    "seo:generate": "npm run generate:sitemap",
    "seo:validate": "npm run seo:audit",
    "build:seo": "npm run build",
    "build": "npm run seo:content:sync && npm run images:optimize && npm run generate:sitemap && tsc && vite build && npm run test:production-no-msw && npm run test:production-api-base && npm run prerender && npm run test:public-seo-content && npm run test:prerender-content && npm run test:hydration && npm run test:public-performance && npm run seo:audit",
    "test:production-no-msw": "node scripts/verify-production-no-msw.mjs",
    "test:production-api-base": "node scripts/verify-production-api-base.mjs",
    "test:public-performance": "node scripts/verify-public-performance.mjs",
    "test:prerender-content": "node scripts/verify-prerender-seo-content.mjs",
    "test:public-seo-content": "node scripts/verify-public-seo-content.mjs",
    "test:prerender-content:live": "node scripts/verify-prerender-seo-content.mjs --live",
    "test:hydration": "node --experimental-websocket scripts/verify-hydration.mjs",
    "test:hydration:live": "node --experimental-websocket scripts/verify-hydration.mjs --live",
    "test:p0-seo": "node --test tests/canonical.test.mjs tests/nginx-url-normalization.test.mjs tests/robots-policy.test.mjs tests/sitemap-policy.test.mjs tests/seo-automation.test.mjs && npm run test:prerender-content && npm run test:hydration",
    "test:p0-seo:live": "npm run test:prerender-content:live && npm run test:hydration:live",
    "test": "node --test tests/*.test.mjs && vitest run --dir tests --maxWorkers=1 --exclude **/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.5.7",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@tanstack/react-query": "^5.5.0",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.82.0",
    "react-icons": "^4.11.0",
    "react-router-dom": "^6.15.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.39",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
